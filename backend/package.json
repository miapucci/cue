{
  "name": "cue-api",
  "version": "1.0.0",
  "description": "Cue backend API — auth, briefs, submissions, Stripe escrow",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp src/db/schema.postgres.sql dist/db/",
    "start": "node dist/index.js",
    "dev": "NODE_OPTIONS=--no-deprecation tsx watch src/index.ts",
    "db:init": "node -e \"require('./dist/db').initDb()\""
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "apple-signin-auth": "^1.7.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jose": "^6.1.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "stripe": "^17.4.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
